{
    "servers": {
        "aws-mcp": {
            "command": "uvx",
            "args": [
                "mcp-proxy-for-aws-cli@latest",
                "https://aws-mcp.us-east-1.api.aws/mcp",
                "--metadata",
                "AWS_REGION=ap-southeast-2"
            ],
            "env": {
                "AWS_MCP_PROXY_PROFILES": "wxpwindy default"
            }
        }
    }
}